# Copy this file to ".env" and fill in your values.
# NEVER commit the real .env file (it is gitignored).

# --- OpenRouter (moment selection) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used to pick clip moments. Use a ":free" text model with a large context window.
# Good picks: deepseek/deepseek-chat-v3-0324:free , qwen/qwen-2.5-72b-instruct:free
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# OpenAI-compatible base URL. Swap this to use Groq / Ollama / etc. without code changes.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- whisper.cpp (transcription) ---
# Path to the whisper-cli binary you built (Step 2 of the setup).
WHISPER_CLI=/absolute/path/to/whisper.cpp/build/bin/whisper-cli
# Path to the ggml model you downloaded (Step 3).
WHISPER_MODEL=/absolute/path/to/whisper.cpp/models/ggml-large-v3-turbo.bin
# Transcription language: id, en, or auto
WHISPER_LANG=id

# --- ffmpeg ---
# Leave as "ffmpeg" if it is on your PATH (brew install ffmpeg).
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
