{
  "name": "auto-clipper",
  "version": "0.1.0",
  "description": "Auto-clipper CLI: video -> whisper.cpp transcript -> OpenRouter picks moments -> vertical 9:16 clips with karaoke captions",
  "type": "module",
  "bin": {
    "clipper": "./src/index.ts"
  },
  "scripts": {
    "clip": "tsx src/index.ts",
    "web": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
